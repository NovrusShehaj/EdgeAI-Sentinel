# Copy values into your shell or a gitignored .env next to compose.
# GRAFANA_ADMIN_PASSWORD is required to render or start the default stack.
# API_TOKEN is required to run inference on --profile with-api; it is not
# required to start Prometheus or Grafana. Leave it empty here; do not commit
# a real value.
GRAFANA_ADMIN_PASSWORD=
API_TOKEN=
SENTINEL_MODEL_DIR=../../models
