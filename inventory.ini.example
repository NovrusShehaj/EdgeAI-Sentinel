# Copy to inventory.local.ini (gitignored) and fill in real hosts.
# Do not commit production inventory or SSH private keys.

[edge_devices]
# pi-01 ansible_host=192.168.1.101 ansible_user=pi ansible_ssh_private_key_file=~/.ssh/id_rsa

[edge_devices:vars]
monitoring_server_ip=192.168.1.10
ansible_ssh_common_args=-o ConnectTimeout=10
ansible_become_method=sudo
# SSH host-key checking stays enabled. Do not set ANSIBLE_HOST_KEY_CHECKING=False.
