# EdgeAI Sentinel — Edge Device Container
# Target: Raspberry Pi 4/5 (ARM64) or any OCI-compatible runtime.
# Models are not baked into the image. Mount a versioned ONNX artifact at runtime.

FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-edge.txt constraints-edge.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements-edge.txt -c constraints-edge.txt


FROM python:3.11-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="EdgeAI Sentinel Edge"
LABEL org.opencontainers.image.description="Low-SWaP AI inference server"
LABEL org.opencontainers.image.version="0.2.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgomp1 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /install /usr/local
COPY edge/ ./edge/
COPY configs/ ./configs/

RUN useradd --uid 1000 --no-create-home --shell /usr/sbin/nologin sentinel \
    && mkdir -p /app/models /tmp \
    && chown -R sentinel:sentinel /app

USER sentinel

ENV MODEL_PATH=/app/models/best.onnx
ENV MODEL_MANIFEST_PATH=/app/models/model_manifest.json
ENV CLASS_NAMES=object
ENV CONF_THRESHOLD=0.45
ENV IOU_THRESHOLD=0.45
ENV NUM_THREADS=4
ENV PORT=8080
ENV PYTHONPATH=/app
ENV PATH=/usr/local/bin:$PATH
ENV INFER_TIMEOUT_S=5
ENV MAX_UPLOAD_BYTES=5242880
ENV MAX_IMAGE_SIDE=4096
ENV ALLOWED_HOSTS=*

EXPOSE 8080

# Liveness only: /ready is 503 until a model is mounted.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/live')"

CMD ["python", "-m", "uvicorn", "edge.api:app", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "--workers", "1", \
     "--log-level", "info"]
